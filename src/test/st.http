@host = http://localhost:8080
### 登录成功
POST http://localhost:8080/user/login
Content-Type: application/json

{"username":"caiye","password":"123456"}


### 密码错误
POST http://localhost:8080/user/login
Content-Type: application/json

{"username":"caiye","password":"wrong"}


### 用户不存在
POST http://localhost:8080/user/login
Content-Type: application/json

{"username":"nobody","password":"123456"}


### 空用户名
POST http://localhost:8080/user/login
Content-Type: application/json

{"username":"","password":"123456"}

###
POST http://localhost:8080/user/register
Content-Type: application/json

{"username":"caiye2","password":"123456"}

###
POST {{host}}/user/login
Content-Type: application/json

{"username":"caiye","password":"123456"}

> {%
  client.global.set("token", response.body.data);
    client.log("token = " + client.global.get("token"));
 %}

###
GET {{host}}/record

###
GET {{host}}/record
Authorization: Bearer abc.def.ghi

###
GET {{host}}/record
Authorization: Bearer {{token}}

###
POST {{host}}/record
Content-Type: application/json
Authorization: Bearer {{token}}

{"amount":12.5,"type":1,"category":"餐饮","note":"测试","recordDate":"2026-11-10"}
