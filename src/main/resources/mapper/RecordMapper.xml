<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper  namespace="com.yjj.accountbook.mapper.RecordMapper">
<sql id="pageWhere">
<where>
and user_id=#{userId}
<if test="start != null">and record_date &gt;= #{start}</if>
<if test="end != null">and record_date &lt; #{end}</if>
<if test="type != null">and type = #{type}</if>
<if test="category != null and category != ''">and category = #{category}</if>
        </where>
</sql>
<select id="findPage" resultType="com.yjj.accountbook.entity.AccountRecord">
select * from `record`
<include refid="pageWhere"/>
order by record_date desc, id desc
limit #{offset}, #{size}
</select>
<select id="countPage" resultType="long">
select count(*) from `record`
<include refid="pageWhere"/>
</select>
        </mapper>